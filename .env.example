# Copy the variables you need into your shell environment (Eval Triage does not
# load .env files automatically). All values below are examples only.

# Where evaluation data (SQLite database, artifacts, isolated MemoryAI stores) lives.
EVAL_TRIAGE_DATA_DIR=./.data
EVAL_TRIAGE_API_PORT=8310

# MemoryAI bridge: the existing checkout and its own interpreter. Eval Triage
# never installs into or modifies either, and never touches its real store.
MEMORYAI_SOURCE_PATH=/path/to/memoryai
MEMORYAI_PYTHON=/path/to/memoryai/.venv/bin/python

# Provider credentials are referenced by variable NAME in target configs;
# values are read server-side only and never returned to the UI or exports.
OPENAI_API_KEY=sk-example-not-a-real-key
ANTHROPIC_API_KEY=sk-ant-example-not-a-real-key
